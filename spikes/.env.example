# Partner JWT from https://partners.near-intents.org (sent as X-API-Key)
ONECLICK_JWT=

# Two throwaway EVM keys used as Intents accounts (erc191). Fill with `npm run keygen`.
# Test keys only: hold a few dollars at most.
ALICE_PK=
BOB_PK=

# Where refunds go if a deposit fails (an address on the origin chain you deposit from)
REFUND_TO=

# Asset you deposit from in spike 2 (1Click asset id). Default: USDC on NEAR.
ORIGIN_ASSET=nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1

# Amounts in USD (USDC has 6 decimals)
DEPOSIT_USD=40
SEND_USD=2
BUY_USD=30

# 0 = dry quotes only (no money moves). 1 = real mainnet execution.
LIVE=0

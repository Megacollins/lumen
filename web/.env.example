# Encrypts the session cookie. 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Optional NEAR Intents partner key (https://partners.near-intents.org). Required for confidential quotes.
ONECLICK_JWT=

# Postgres for Strategies and Smart Alerts (Neon via Vercel: `vercel integration add neon`). Without it, those
# screens say they aren't set up; everything else works.
DATABASE_URL=

# Optional: Vercel sends this to /api/cron/prices (the daily price snapshot) so only the scheduler can trigger it.
CRON_SECRET=

# Local testing only (never in production): lets a dev server run order flows that haven't passed their live
# mainnet test yet, and skips the balance check so an empty account can exercise the pipeline.
# LUMEN_DEV_EXECUTION=1
